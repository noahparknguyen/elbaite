root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120
# Pinned rather than left to the IDE scheme: hand-wrapped throws kept collapsing onto one
# line. wrap_long_lines was tried alongside this and removed -- it "fixes" an over-long
# line by splitting string literals into concatenations, which is worse than the problem.
ij_java_keep_line_breaks = true

[*.xml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
