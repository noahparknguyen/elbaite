root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120
# Pinned rather than left to the IDE scheme: hand-wrapped throws kept collapsing onto one
# line, and wrap_long_lines makes anything over the margin re-wrap on the next format.
ij_java_keep_line_breaks = true
ij_java_wrap_long_lines = true

[*.xml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
