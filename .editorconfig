root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 100
# Long statements are wrapped by hand at 100. keep_line_breaks (IntelliJ's default, pinned
# here) keeps those breaks through a reformat, provided the IDE option "Reformat again to
# remove custom line breaks" stays off. wrap_on_typing is off because, when typing runs
# past the margin inside a string literal, it splits the literal into a concatenation.
ij_java_keep_line_breaks = true
ij_java_wrap_on_typing = false

[*.xml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
